# Daytona sandbox
DAYTONA_API_KEY="your_daytona_api_key_here"
DAYTONA_API_URL="https://app.daytona.io/api"
USE_LOCAL_FALLBACK="false"   # true = run generated code in a local subprocess (offline demo backup)

# LLM endpoint (OpenAI-compatible; point at your Nosana vLLM/Ollama deployment)
LLM_API_KEY="your_openai_or_nosana_api_key"
LLM_BASE_URL="https://api.openai.com/v1"
FORWARD_MODEL="gpt-4o-mini"
BACKWARD_MODEL="gpt-4o"

# Neo4j (Aura: neo4j+s://xxxx.databases.neo4j.io)
# Note: on Daytona Tier 1/2 the sandbox likely cannot reach Aura, so write to Neo4j from the host app.
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your_password"
