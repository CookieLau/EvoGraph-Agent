# EvoGraph-Quant configuration. Copy to .env (setup.sh does this) and fill in what you have.
# Every block is optional. Leave unknown values EMPTY: placeholders make the app retry and stall.
# Put keys here, not in shell exports (llm_client loads .env with override=True). See AGENTS.md.
#   no Daytona key  -> USE_LOCAL_FALLBACK path (local subprocess, labelled "Local Fallback")
#   no LLM          -> use "Replay" or "scripted LLM" mode
#   no Neo4j        -> orchestrator --no-neo4j (contagion computed locally)

# --- Daytona sandbox (execution verifier) ---------------------------------
DAYTONA_API_KEY=""                       # https://app.daytona.io -> API keys
DAYTONA_API_URL="https://app.daytona.io/api"
USE_LOCAL_FALLBACK="false"               # "true" = skip Daytona, run scripts in a local subprocess

# --- LLM: any OpenAI-compatible endpoint ----------------------------------
# Our demo: Ollama on a Nosana GPU, reached via scripts/nosana_relay.py (machine-specific, needs our SSH key).
# Fresh machine: point this at OpenAI, a Nosana vLLM/Ollama endpoint, or a local Ollama.
LLM_API_KEY=""                           # "ollama" for Ollama; your key for OpenAI
LLM_BASE_URL=""                          # e.g. https://api.openai.com/v1, or http://127.0.0.1:11434/v1 for Ollama
FORWARD_MODEL=""                         # writes the ETL script   (OpenAI: gpt-4o-mini; demo: qwen3.8:27b)
BACKWARD_MODEL=""                        # rewrites the prompt     (OpenAI: gpt-4o-mini or gpt-4o; not o-series)
# OPENAI_API_KEY=""                      # also accepted as a fallback key

# Optional second endpoint, used only if the primary LLM fails
FALLBACK_BASE_URL=""
FALLBACK_API_KEY=""
FALLBACK_FORWARD_MODEL=""
FALLBACK_BACKWARD_MODEL=""
# LLM_PREFER="fallback"                  # force the fallback endpoint first

# --- Neo4j (contagion graph + agent lineage) ------------------------------
# Aura free tier works: neo4j+s://xxxx.databases.neo4j.io. Written from the HOST (sandboxes are offline).
NEO4J_URI=""
NEO4J_USER="neo4j"
NEO4J_PASSWORD=""
NEO4J_DATABASE="neo4j"
# GRAPH_MEMORY="0"                       # default on: later runs recall past fixes from Neo4j; "0" = off + full wipe on reset
