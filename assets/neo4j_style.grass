node {
  diameter: 55px;
  color: #A5ABB6;
  border-color: #6B7280;
  border-width: 2px;
  text-color-internal: #FFFFFF;
  font-size: 11px;
  caption: "{name}";
}
relationship {
  color: #EF553B;
  shaft-width: 2px;
  font-size: 9px;
  padding: 3px;
  text-color-external: #111827;
  text-color-internal: #FFFFFF;
  caption: "{weight}";
}
